{{ define "media_filter" }}
    <form id="media-filters"
          class="mb-6 flex flex-wrap items-end gap-x-8 gap-y-4"
          hx-get="media" hx-target="#media-table" hx-swap="outerHTML" hx-select="#media-table"
          hx-push-url="true" hx-sync="this:replace"
          hx-trigger="submit, input delay:300ms from:input[name=name], input delay:300ms from:input[name=minSize], change from:input[name=okOnly]">
        <input type="hidden" name="sortKey" value="{{ .SortInfo.Key }}">
        <input type="hidden" name="sortOrder" value="{{ .SortInfo.Order }}">
        {{ template "filter_name_input" .MediaFilter.Name }}
        {{ template "filter_size_input" .MediaFilter.MinSize }}
        {{ template "filter_ok_input" .MediaFilter.OkOnly }}
    </form>
{{ end }}

{{ define "media_filter_query" }}name={{ .Name }}&minSize={{ .MinSize }}&okOnly={{ .OkOnly }}{{ end }}
